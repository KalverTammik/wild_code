QToolButton#ExtraInfoHandleButton {
  background: qlineargradient(x1:0,y1:0,x2:0,y2:1,
      stop:0 rgba(255,255,255,0.98),
      stop:0.42 rgba(244,247,251,0.98),
      stop:1 rgba(219,226,235,0.98)
  );
  color: #4f5d6b;
  border: 1px solid rgba(138,151,166,0.42);
  border-bottom: 1px solid rgba(104,116,130,0.58);
  border-radius: 7px;
  padding: 0;
  font-size: 11px;
  font-weight: 700;
}

QToolButton#ExtraInfoHandleButton:hover {
  background: qlineargradient(x1:0,y1:0,x2:0,y2:1,
      stop:0 rgba(255,255,255,1.0),
      stop:0.40 rgba(239,246,255,1.0),
      stop:1 rgba(200,217,238,1.0)
  );
  color: #1f4f7a;
  border: 1px solid rgba(76,129,177,0.62);
  border-bottom: 1px solid rgba(42,91,137,0.72);
}

QToolButton#ExtraInfoHandleButton:pressed {
  background: #c9d7e6;
  padding-top: 1px;
  padding-bottom: 0px;
}

QToolButton#ExtraInfoHandleButton:checked,
QToolButton#ExtraInfoHandleButton:focus {
  background: #e5eff9;
  border: 1px solid #6b9cc6;
}

QLabel#WorksPendingGisTitle {
  color: #333;
  font-weight: 600;
  font-size: 14px;
  margin-bottom: 10px;
}

QFrame#ProjectBoardItemWidget {
  border: 1px solid #d9dee7;
  border-radius: 6px;
  background: #fbfcfe;
}

QLabel#ProjectBoardItemPrimary,
QLabel#ProjectBoardGroupTitle {
  color: #243447;
  font-weight: 600;
}

QLabel#ProjectBoardItemSecondary,
QLabel#ProjectBoardEmptyLabel {
  color: #667085;
}

QLabel#ProjectBoardItemSecondary {
  font-size: 11px;
}

QLabel#ProjectBoardSectionTitle {
  font-weight: 600;
}

QFrame#FormSeparator {
    background: #e1e4e8;
    border: none;
}

QLabel#AsBuiltNotesItemName {
  color: #243447;
  font-size: 14px;
  font-weight: 600;
}

QLabel#AsBuiltNotesOpenCount,
QLabel#AsBuiltNotesColumnHeader {
  color: #667085;
}

QLabel#AsBuiltNotesColumnHeader {
  font-size: 11px;
}

QLabel#AsBuiltNotesGroupTitle {
  color: #243447;
  font-weight: 600;
}

QFrame#AsBuiltNotesGroupLine {
  background: #e4e7ec;
  border: none;
}

QTextEdit#AsBuiltNoteTextEdit[resolved="true"] {
  color: #667085;
}

QToolButton#AsBuiltNoteDeleteButton {
  border: none;
  border-radius: 4px;
  background: transparent;
}

QToolButton#AsBuiltNoteDeleteButton:hover {
  background: rgba(217, 45, 32, 0.12);
}

QPushButton#AsBuiltNotesAddButton {
  border: none;
  background: transparent;
  color: #0969da;
  padding: 4px 2px;
}

QPushButton#AsBuiltNotesAddButton:hover {
  color: #0550ae;
}
