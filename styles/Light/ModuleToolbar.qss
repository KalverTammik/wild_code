QWidget#ToolbarLeft {
    border: 1px solid #0984E3;
    border-radius: 8px;  /* Rounded corners */   
}

QWidget#FilterWidgetContainer {
    background: transparent;
}

QWidget#FilterActionsContainer {
    background: #ffffff;
    border: 1px solid #d7dee5;
    border-radius: 6px;
    margin: 2px;
}

QWidget#FilterActionsContainer:hover {
    background: #f9fafb;
    border-color: #2188ff;
}

QWidget#FilterActionsContainer QPushButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 5px;
    padding: 0;
}

QWidget#FilterActionsContainer QPushButton:hover {
    background: rgba(33,136,255,0.10);
    border-color: rgba(33,136,255,0.35);
}

QWidget#FilterActionsContainer QPushButton:pressed {
    background: rgba(33,136,255,0.18);
}

QLabel#FilterTitleLabel {
    color: #5f6a7d;
    font-size: 10px;
    font-weight: 600;
    padding-left: 2px;
    padding-right: 2px;
}

QToolButton#FeedSortButton, QToolButton#FeedGroupButton {
    background: #ffffff;
    color: #244455;
    border: 1px solid #cad7e2;
    border-radius: 5px;
    padding: 3px 14px 3px 6px;
    min-height: 16px;
}
QToolButton#FeedSortButton[active="true"], QToolButton#FeedGroupButton[active="true"] {
    background: #e3f0ff;
    border-color: #2188ff;
}
QToolButton#FeedSortButton:hover, QToolButton#FeedGroupButton:hover,
QToolButton#FeedSortButton:focus, QToolButton#FeedGroupButton:focus {
    background: #f0f6fb;
    border-color: #2188ff;
}
QToolButton#FeedGroupHeader {
    background: #f0f6fb;
    color: #244455;
    border: 0;
    border-bottom: 1px solid #cad7e2;
    border-radius: 3px;
    padding: 3px 5px;
    min-height: 18px;
    text-align: left;
    font-weight: 600;
}
QToolButton#FeedGroupHeader:hover, QToolButton#FeedGroupHeader:focus {
    background: #e3f0ff;
}
