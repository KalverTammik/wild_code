/* =========================================================
   DARK THEME — Core surface + controls
   Palette:
   - Base bg:        #1d252b
   - Surface:        #2e2f38 / #303a42
   - Text:           #c5c5d2  (body), #e8e9ef (titles)
   - Accent (teal):  rgb(9,144,143)
   ========================================================= */

/* Root surfaces (avoid global * to prevent bleed) */
QWidget {
    background: #1d252b;
    color: #c5c5d2;
    font-size: 12px;
    border: none;
}

QDialog {
    background: #1d252b;  /* Match QWidget base */
    border: 1px solid #4d4d4d;  /* Subtle dark border */
    border-radius: 8px;  /* Rounded corners */
}

QFrame { background: transparent; }

/* ---------- Inputs ---------- */
QLineEdit, QTextEdit, QPlainTextEdit, QAbstractSpinBox, QComboBox {
    background: #303a42;
    color: #c5c5d2;
    border: 1px solid #4d4d4d;
    border-radius: 6px;
    padding: 6px 8px;
}
QLineEdit::placeholder, QTextEdit::placeholder, QPlainTextEdit::placeholder {
    color: rgba(197,197,210,0.55);
}
QLineEdit:hover, QTextEdit:hover, QPlainTextEdit:hover, QAbstractSpinBox:hover, QComboBox:hover,
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QAbstractSpinBox:focus, QComboBox:focus {
    background: #2e2f38;
    border: 1px solid #1f5d5c;  /* teal focus */
}

/* Disabled inputs */
QLineEdit:disabled, QTextEdit:disabled, QPlainTextEdit:disabled, QAbstractSpinBox:disabled, QComboBox:disabled {
    background: #24252e;
    color: rgba(170,170,180,0.55);
    border: 1px dashed rgba(120,120,130,0.50);
}

/* The QGIS UI theme draws these input buttons dark; here they blend into the field like a combo box arrow. */
QAbstractSpinBox::drop-down,
QComboBox::drop-down:editable {
    margin: 0 2px 0 0;
    background: transparent;
    border: none;
}
QAbstractSpinBox::up-button,
QAbstractSpinBox::down-button {
    background: transparent;
    border: none;
}

/* ---------- Calendar popup of date fields ---------- */
QCalendarWidget QWidget {
    alternate-background-color: #303a42;
}
QCalendarWidget QWidget#qt_calendar_navigationbar {
    background: #2e2f38;
}
QCalendarWidget QToolButton {
    background: transparent;
    color: #c5c5d2;
    border: none;
    border-radius: 6px;
    padding: 2px 4px;
}
QCalendarWidget QToolButton:hover {
    background: rgba(255,255,255,0.08);
}
QCalendarWidget QToolButton#qt_calendar_monthbutton {
    padding-right: 16px;
}
QCalendarWidget QToolButton::menu-indicator {
    subcontrol-origin: padding;
    subcontrol-position: center right;
}
QCalendarWidget QSpinBox {
    padding: 1px 4px;
}
QCalendarWidget QMenu {
    background: #2e2f38;
    color: #c5c5d2;
}
QCalendarWidget QAbstractItemView:enabled {
    background: #2e2f38;
    color: #c5c5d2;
    border: none;
    border-radius: 0;
    outline: none;
    selection-background-color: #1a6468;
    selection-color: #ececf1;
}
QCalendarWidget QAbstractItemView:disabled {
    color: rgba(197,197,210,0.40);
}

/* ---------- Tabs ---------- */
QTabWidget::pane {
    background: transparent;
    border: none;
    border-top: 1px solid #4d4d4d;
    top: -1px;
}
/* The weight goes on the bar: Qt measures a tab with the bar's font, so on ::tab alone it clips the text. */
QTabBar {
    background: transparent;
    font-weight: 600;
}
QTabBar::tab {
    background: transparent;
    color: rgba(197,197,210,0.65);
    border: none;
    border-bottom: 2px solid transparent;
    padding: 6px 14px;
    margin: 0;
}
QTabBar::tab:hover {
    color: #e8e9ef;
}
QTabBar::tab:selected {
    background: transparent;
    color: #e8e9ef;
    border-bottom: 2px solid rgb(9,144,143);
}
QTabBar::tab:!selected {
    margin-top: 0;
}

/* ---------- Checkboxes ---------- */
QCheckBox {
    color: #d1d1e0;
}
/* image: the QGIS UI theme's own check box images would otherwise cover these. */
QCheckBox::indicator {
    width: 16px; height: 16px;
    border-radius: 3px;
    background: #303a42;
    border: 1px solid #4d4d4d;
    image: none;
}
QCheckBox::indicator:checked {
    background: rgb(9,144,143);
    border: 1px solid rgb(9,144,143);
    image: url(check_white.svg);
}
QCheckBox::indicator:hover { border: 1px solid #1f5d5c; }
QCheckBox::indicator:disabled {
    background: #1d252b;
    border: 1px dashed rgba(120,120,130,0.5);
}
QCheckBox::indicator:checked:disabled {
    background: rgba(9,144,143,0.45);
    border: 1px solid transparent;
}

/* ---------- Lists / Tables / Trees ---------- */
QListWidget, QTableView, QTreeView {
    background: #2e2f38;
    color: #c5c5d2;
    border: 1px solid #4d4d4d;
    border-radius: 6px;
}
QListWidget::item {
    padding: 4px 6px;
    border-radius: 4px;
}
QListWidget::item:hover { background: #3a3f4b; }
QListWidget::item:selected {
    background: rgba(9,144,143,0.85);
    color: #ececf1;
}

/* Table specifics */

/* ---------- Table chrome aligned with teal/slate scheme ---------- */
QTableView, QTableWidget {
    background: #2e2f38;
    color: #c5c5d2;
    border: 1px solid #4d4d4d;
    border-radius: 10px;
    outline: 0;
    selection-background-color: transparent;
}

/* Teal focus ring like buttons */
QTableView:focus, QTableWidget:focus {
    border: 1px solid rgba(9,144,143,0.55);
}

QTableView::viewport, QTableWidget::viewport {
    background: #2e2f38;
}

QTableView::item, QTableWidget::item {
    background: transparent;
    color: #c5c5d2;
    padding: 1px 1px;
    border: none;
}
QTableView::item:alternate, QTableWidget::item:alternate {
    background: #303a42;
}
QTableView::item:hover, QTableWidget::item:hover {
    background: #3a3f4b;
}
QTableView::item:selected, QTableWidget::item:selected {
    background: rgba(9,144,143,0.55);
    color: #ececf1;
}
QTableView::item:selected:!active, QTableWidget::item:selected:!active {
    background: rgba(9,144,143,0.55);
    color: #ececf1;
}

/* Header (dark slate with teal accent) */
QTableView QHeaderView::section,
QTableWidget QHeaderView::section {
    background: rgba(9,144,143,0.50);
    color: #e8e9ef;
    font-weight: 700;
    padding: 1px 1px;
    border: none;
    border-right: 1px solid #1f2937;
    border-bottom: 2px solid rgb(9,144,143);
}

/* If you hide vertical header, this won't show; harmless to keep */
QHeaderView::section:vertical {
    background: rgba(9,144,143,0.50);
    color: #e8e9ef;
    border: none;
    border-bottom: 1px solid #1f2937;
}

/* Corner button (top-left) */
QTableCornerButton::section {
    background: rgba(9,144,143,0.50);
    border: none;
    border-right: 1px solid #1f2937;
    border-bottom: 2px solid rgb(9,144,143);
}

/* Slightly nicer header hover (optional) */
QHeaderView::section:hover {
    background: rgba(9,144,143,0.75);
}

/* Tree specifics */
QTreeView::item {
    padding: 4px 6px;
    background: #2e2f38;
    border: none;
    color: #d1d1e0;
}
QTreeView::item:hover { background: #3a3f4b; }
QTreeView::item:selected {
    border-radius: 4px;
}

/* ---------- GroupBox ---------- */
QGroupBox {
    background: rgba(46,47,56,1);
    border: 1px solid rgba(9,144,143,0.60);
    border-radius: 8px;
    margin-top: 18px;
}
QGroupBox::title {
    color: #e8e9ef;
    font-weight: 600;
    padding: 2px 6px;
}

/* ---------- Scrollbars to match (rounded handles) ---------- */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 1px;
}
QScrollBar::handle:vertical {
    background: rgba(9,144,143,0.40);
    border-radius: 2px;
    min-height: 20px;
    margin: 1px;
    border: 1px solid rgba(9,144,143,0.25);
}
QScrollBar::handle:vertical:hover {
    background: rgba(9,144,143,0.55);
    border: 1px solid rgba(9,144,143,0.35);
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
    background: transparent;
}
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 1px;
}
QScrollBar::handle:horizontal {
    background: rgba(9,144,143,0.40);
    border-radius: 2px;
    min-width: 20px;
    margin: 1px;
    border: 1px solid rgba(9,144,143,0.25);
}
QScrollBar::handle:horizontal:hover {
    background: rgba(9,144,143,0.55);
    border: 1px solid rgba(9,144,143,0.35);
}
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
    background: transparent;
}
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: transparent;
}


/* ---------- Links in rich text labels (global) ---------- */
QLabel a {
    color: #c5c5d2;
    text-decoration: none;
}
QLabel a:hover { color: #ffffff; text-decoration: underline; }
QLabel a:active { color: #a8f1ef; }


/* ---------- GlowProgressBar ---------- */
GlowProgressBar {
    qproperty-trackColor: #253038;
    qproperty-borderColor: rgba(9,144,143,0.55);
    qproperty-chunkColor: #09908f;
    qproperty-chunkAccentColor: #5eead4;
    qproperty-errorColor: #ef4444;
    qproperty-textColor: #e8e9ef;
    qproperty-chunkTextColor: #ffffff;
}
