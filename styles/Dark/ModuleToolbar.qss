QWidget#ToolbarLeft {
	border: 1px solid rgba(9, 144, 143, 0.70);
	border-radius: 8px;
	background-color: rgba(9, 144, 143, 0.08);
}

QWidget#FilterWidgetContainer {
	background: transparent;
}

QWidget#FilterActionsContainer {
	background: #303a42;
	border: 1px solid #4d4d4d;
	border-radius: 6px;
	margin: 2px;
}

QWidget#FilterActionsContainer:hover {
	background: #2e2f38;
	border-color: #1f5d5c;
}

QWidget#FilterActionsContainer QPushButton {
	background: transparent;
	border: 1px solid transparent;
	border-radius: 5px;
	padding: 0;
}

QWidget#FilterActionsContainer QPushButton:hover {
	background: rgba(9, 144, 143, 0.18);
	border-color: rgba(9, 144, 143, 0.50);
}

QWidget#FilterActionsContainer QPushButton:pressed {
	background: rgba(9, 144, 143, 0.28);
}

QLabel#FilterTitleLabel {
	color: #cbd5f5;
	font-size: 10px;
	font-weight: 600;
	padding-left: 2px;
	padding-right: 2px;
}

QToolButton#FeedSortButton, QToolButton#FeedGroupButton {
    background: #232b33;
    color: #e2e8f0;
    border: 1px solid #425263;
    border-radius: 5px;
    padding: 3px 14px 3px 6px;
    min-height: 16px;
}
QToolButton#FeedSortButton[active="true"], QToolButton#FeedGroupButton[active="true"] {
    background: #344c66;
    border-color: #2188ff;
}
QToolButton#FeedSortButton:hover, QToolButton#FeedGroupButton:hover,
QToolButton#FeedSortButton:focus, QToolButton#FeedGroupButton:focus {
    background: #2d3e50;
    border-color: #2188ff;
}
QToolButton#FeedGroupHeader {
    background: #2d3e50;
    color: #e2e8f0;
    border: 0;
    border-bottom: 1px solid #425263;
    border-radius: 3px;
    padding: 3px 5px;
    min-height: 18px;
    text-align: left;
    font-weight: 600;
}
QToolButton#FeedGroupHeader:hover, QToolButton#FeedGroupHeader:focus {
    background: #344c66;
}
